# Banco. Vazio = SQLite em instance/financial_bot.db.
# Supabase Postgres (aceita postgres:// ou postgresql://):
# DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
DATABASE_URL=

SECRET_KEY=troque-por-uma-chave-longa

# Storage de imagens. Sem estas variáveis o app sobe e guarda arquivos localmente.
SUPABASE_URL=
SUPABASE_KEY=

# E-mail do código de recuperação. Sem SMTP_HOST o código é impresso no console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
